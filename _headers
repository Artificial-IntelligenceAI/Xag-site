# Everything, unless something below says otherwise.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # The page itself is never cached: every path serves index.html, and a cached
  # one is a reader stuck on last week's build with no way to know.
  Cache-Control: no-cache

# The build names these after their contents, so a changed file is a changed
# name and an unchanged one can be kept for good.
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
