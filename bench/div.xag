# The other half of the same change: `/` went from a runtime call to the
# machine's own instruction at the same time `mod` did, so it is worth a case
# of its own to keep it that way.

START {
    var.mut.int64 'total' = [*0*];
    loop.range.int64 'i' = [*1*, *1000000000*] {
        set 'total' = ['total' + ('i' / *7*)];
    }
    print.stdout[str:*total * 'total' \n];
}
